# Pollgen LLM service environment example
USER_HOME=C:/Users/ADITYA/Desktop/NLP
PORT=5001
MONGO_URI=mongodb://localhost:27017/

# API keys used by the LLM/service (leave blank and set in your secure env)
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Local storage for vector DB (if used)
CHROMA_DB_DIR=./chroma_langchain_db

# Optional Ollama (local LLM)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Virtual environment directory (used by the included run script)
VIRTUAL_ENV=llm-env

# Optional tuning params
# MAX_WORKERS=2