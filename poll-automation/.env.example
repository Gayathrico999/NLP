# Root-level example environment for quick reference
# Backend
BACKEND_PORT=3000

# Frontend
FRONTEND_PORT=5173

# Whisper
WHISPER_PORT=8000
WHISPER_CHUNK_DURATION=30
WHISPER_MODEL=tiny

# LLM
LLM_PORT=5001

# MongoDB (if running locally)
MONGO_URI=mongodb://localhost:27017/

# Notes:
# - Copy relevant settings into the specific service `.env` files before starting.